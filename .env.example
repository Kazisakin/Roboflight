# ──────────────────────────────────────────────────────────────
# RoboFlight — Environment Variables
# Copy this file to .env.local for local dev, or add these
# variables in Vercel Dashboard → Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────

# SMTP — used by the contact form API (/api/contact)
# For Gmail: enable 2FA then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

# The email address that receives contact form submissions
CONTACT_EMAIL=your-gmail@gmail.com

# ──────────────────────────────────────────────────────────────
# Analytics & ads — leave blank until you have them. Nothing loads
# until a visitor clicks "Accept all" on the cookie banner.
# ──────────────────────────────────────────────────────────────

# Google Search Console → HTML tag verification → the content="..." value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 → Admin → Data streams → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Ads → Goals → Conversions → tag setup (AW-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label for "Book free class" (the part after the slash in send_to)
NEXT_PUBLIC_GOOGLE_ADS_BOOK_LABEL=
# Optional: conversion label for phone-number clicks
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=

# Meta Events Manager → Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Events Manager → Settings → Conversions API → Generate access token (server only, keep secret)
META_CAPI_TOKEN=
# Optional, only while testing in Events Manager → Test events
META_TEST_EVENT_CODE=
